#version 4
import sys
import time
import random
import numpy as np

print("==================================================================")
print('                     ROCK • PAPER • SCISSOR                       ')
print("==================================================================")

rock = np.array([1,0,0])
paper = np.array([0,1,0])
scissor = np.array([0,0,1])
score_board=[0,0,0]

dict1 = {
    '1': rock,
    '2': paper,
    '3': scissor
}

rev = {
    tuple(rock): "rock",
    tuple(paper): "paper",
    tuple(scissor): "scissor"
}

def type_print(text):
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(0.1)
    print()

while True:
    y = input("Choose your move: \n [1] ✊   Rock \t [2] 🖐  Paper \t [3] ✌️   Scissor \n")

    x = random.choice(list(dict1.keys()))
    engine_hand = dict1[x]
 
    type_print("Thinking......")
    
    time.sleep(2)
    print('Engine plays: ', rev[tuple(engine_hand)])
    time.sleep(1)
    result = np.cross(engine_hand,dict1[y])
    
    if np.array_equal(result, scissor) or np.array_equal(result, paper) or np.array_equal(result, rock):
        print('🔥🔥You win !!🔥🔥')
        score_board[0]+=1
    elif np.array_equal(result, [0,0,0]):
        print('Draw..😳')
        score_board[2]+=1
    else:
        print('You lose ?!😭')
        score_board[1]+=1

    print(f'Wins : {score_board[0]}\t\tLoses : {score_board[1]}\t\tTies : {score_board[2]}')
    again = input("\nContinue playing?? (yes/no): ").lower()
    if again != "yes":
        print("Thanks for playing!Goodbye 👋")
        break
    
