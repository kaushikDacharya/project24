import wx
import threading
import random
import time

MOVES = {
    '1': 'Rock',
    '2': 'Paper',
    '3': 'Scissor'
}

class RPSFrame(wx.Frame):
    def __init__(self):
        super().__init__(None, title="Rock Paper Scissors", size=(500, 520))
        self.InitUI()

    def InitUI(self):
        panel = wx.Panel(self)
        panel.SetBackgroundColour("#1e1e2e")  # Dark theme

        main_vbox = wx.BoxSizer(wx.VERTICAL)

        # ===== Title =====
        title = wx.StaticText(panel, label="Rock • Paper • Scissors")
        title_font = wx.Font(18, wx.FONTFAMILY_SWISS, wx.FONTSTYLE_NORMAL, wx.FONTWEIGHT_BOLD)
        title.SetFont(title_font)
        title.SetForegroundColour("#f8f8f2")

        main_vbox.Add(title, 0, wx.ALIGN_CENTER | wx.TOP | wx.BOTTOM, 15)

        # ===== Output Box =====
        self.output = wx.TextCtrl(
            panel,
            style=wx.TE_MULTILINE | wx.TE_READONLY | wx.BORDER_NONE,
            size=(-1, 260)
        )
        self.output.SetBackgroundColour("#282a36")
        self.output.SetForegroundColour("#f8f8f2")
        self.output.SetFont(wx.Font(10, wx.FONTFAMILY_TELETYPE, wx.FONTSTYLE_NORMAL, wx.FONTWEIGHT_NORMAL))

        main_vbox.Add(self.output, 1, wx.EXPAND | wx.LEFT | wx.RIGHT, 20)

        # ===== Buttons =====
        btn_box = wx.BoxSizer(wx.HORIZONTAL)

        for key, label in MOVES.items():
            btn = wx.Button(panel, label=label, size=(120, 45))
            btn.SetBackgroundColour("#6272a4")
            btn.SetForegroundColour("white")
            btn.SetFont(wx.Font(11, wx.FONTFAMILY_SWISS, wx.FONTSTYLE_NORMAL, wx.FONTWEIGHT_BOLD))
            btn.Bind(wx.EVT_BUTTON, lambda e, k=key: self.on_play(k))
            btn_box.Add(btn, 1, wx.ALL, 6)

        main_vbox.Add(btn_box, 0, wx.EXPAND | wx.TOP | wx.LEFT | wx.RIGHT, 15)

        # ===== Quit Button =====
        quit_btn = wx.Button(panel, label="Quit", size=(120, 40))
        quit_btn.SetBackgroundColour("#ff5555")
        quit_btn.SetForegroundColour("white")
        quit_btn.SetFont(wx.Font(10, wx.FONTFAMILY_SWISS, wx.FONTSTYLE_NORMAL, wx.FONTWEIGHT_BOLD))
        quit_btn.Bind(wx.EVT_BUTTON, lambda e: self.Close())

        main_vbox.Add(quit_btn, 0, wx.ALIGN_CENTER | wx.TOP | wx.BOTTOM, 15)

        panel.SetSizer(main_vbox)
        self.Centre()
        self.Show()

    def write(self, text):
        wx.CallAfter(self.output.AppendText, f"{text}\n")

    def on_play(self, player_choice):
        threading.Thread(
            target=self.run_game_logic,
            args=(player_choice,),
            daemon=True
        ).start()

    def run_game_logic(self, player_choice):
        self.write(f"You chose: {MOVES[player_choice]}")
        self.write("Thinking...")
        time.sleep(1)

        cpu_choice = random.choice(['1', '2', '3'])
        self.write(f"Engine chose: {MOVES[cpu_choice]}")

        result = self.calculate_winner(player_choice, cpu_choice)
        self.write(f"RESULT: {result}")
        self.write("-" * 30)

    def calculate_winner(self, p, c):
        if p == c:
            return "Tie!"
        wins = {'1': '3', '2': '1', '3': '2'}
        return "YOU WIN!" if wins[p] == c else "YOU LOSE!"

if __name__ == "__main__":
    app = wx.App()
    RPSFrame()
    app.MainLoop()
