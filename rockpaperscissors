import time
import random
import numpy as np

# initial setup
ROCK = np.array([1, 0, 0])
PAPER = np.array([0, 1, 0])
SCISSOR = np.array([0, 0, 1])

MOVE_MAP = {
    '1': ROCK,
    '2': PAPER,
    '3': SCISSOR,
    '4': "QUIT"
}

# for display
REV_MOVE_MAP = {
    tuple(ROCK): "rock",
    tuple(PAPER): "paper",
    tuple(SCISSOR): "scissor"
}

# [wins, losses, ties]
SCORE_BOARD = [0, 0, 0]

def welcome():
    print("=" * 46)
    print(' ' * 8 + 'ROCK • PAPER • SCISSORS' + ' ' * 8)
    print("=" * 46)

def player_move() -> str:
    while True:
        prompt = "\nChoose your move:\n [1] ✊ Rock\t [2] 🖐 Paper\t [3] ✌ Scissor\t [4] 🚪 Quit\n"
        choice = input(prompt).strip()
        if choice in MOVE_MAP:
            return choice
        print("Invalid choice. Please enter 1, 2, 3, or 4.")

def score(outcome: str):
    global SCORE_BOARD
    
    if outcome == "win":
        print('🔥🔥 You win !! 🔥🔥')
        SCORE_BOARD[0] += 1
    elif outcome == "lose":
        print('You lose 😭')
        SCORE_BOARD[1] += 1
    else:
        print('Draw 😳')
        SCORE_BOARD[2] += 1
        
    wins, losses, ties = SCORE_BOARD
    print(f'\nWins : {wins}\t\tLosses : {losses}\t\tTies : {ties}')

def outcome(engine_hand: np.ndarray, player_hand: np.ndarray):
    result = np.cross(engine_hand, player_hand)

    if np.array_equal(result, [0, 0, 0]):
        score("tie")
    elif any(np.array_equal(result, move) for move in MOVE_MAP.values() if isinstance(move, np.ndarray)):
        # Player wins
        score("win")
    else:
        # Player loses
        score("lose")

def play_game():
    welcome()
    
    while True:
        player_choice_key = player_move()

        # Quit option
        if player_choice_key == '4':
            print("\nThanks for playing! Goodbye 👋")
            break

        player_hand = MOVE_MAP[player_choice_key]

        # engine Move (only 1,2,3)
        engine_choice_key = random.choice(['1', '2', '3'])
        engine_hand = MOVE_MAP[engine_choice_key]

        print("Thinking......")
        time.sleep(1)
        time.sleep(1)
        print('Engine plays:', REV_MOVE_MAP[tuple(engine_hand)])
        time.sleep(0.5)

        # Determine Outcome
        outcome(engine_hand, player_hand)

if __name__ == "__main__":
    play_game()
    
